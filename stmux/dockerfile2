RUN apt-get update
RUN apt-get install -y --force-yes git curl wget screen nano bash
#RUN npm config set user root -g
RUN npm install -g stmux
#RUN rm -rf /usr/local/lib/node_modules/stmux/node_modules/yargs
#RUN cd /usr/local/lib/node_modules/stmux; npm install yargs@13.3.2
RUN cd /root
COPY prompt /root/prompt
COPY bashrc /root/.bashrc
COPY entrypoint /entrypoint
WORKDIR /root
ENTRYPOINT ["/entrypoint"]
