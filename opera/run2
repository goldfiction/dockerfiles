#!/bin/sh
docker rm -f opera
docker volume remove opera
docker volume create opera
docker run -d \
  --name=opera \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=Etc/UTC \
  -p 3500:3001 \
  -v opera:/config \
  --shm-size="2gb" \
  --privileged \
  --restart unless-stopped \
  lscr.io/linuxserver/opera:latest
