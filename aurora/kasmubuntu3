
#!/bin/sh
docker rm -f kasmubuntu3
docker run --name=kasmubuntu3 --rm -d \
  --shm-size=512m \
  -p 6902:6901 \
  -e VNC_PW=password \
  -v /c/Users:/home/host \
  --privileged \
  --security-opt seccomp=unconfined \
  --device /dev/snd:/dev/snd \
  -v /run/user/1000/pulse/native:/tmp/pulse-socket \
  -e PULSE_SERVER=unix:/tmp/pulse-socket \
  kasm

