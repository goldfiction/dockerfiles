docker rm -f opera
docker volume create opera
docker run -d \
  --name=opera \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=Etc/UTC \
  -p 3600:3000 \
  -p 3601:3001 \
  --security-opt seccomp=unconfined \
  -v opera:/config \
  --shm-size="2gb" \
  --restart unless-stopped \
  lscr.io/linuxserver/opera:latest
