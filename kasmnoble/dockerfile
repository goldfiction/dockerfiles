FROM kasmweb/ubuntu-focal-desktop:1.16.0
USER root

# Install dependencies and tools needed for the installation
RUN apt-get update && apt-get install -y \
    wget \
    gnupg2 \
    apt-transport-https \
    ca-certificates \
    libgtk-3-0 \
    libnss3 \
    libasound2 \
    libgbm1 \
    libxss1 \
    libx11-xcb1 \
    && rm -rf /var/lib/apt/lists/*

# Add Opera's official GPG key and APT repository for Opera GX
RUN wget -qO- https://deb.opera.com/archive.key | gpg --dearmor -o /usr/share/keyrings/opera-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/opera-archive-keyring.gpg] https://deb.opera.com/opera-gx-stable/ stable non-free" > /etc/apt/sources.list.d/opera-gx.list

# Fetch the latest Opera GX .deb package directly from Opera's repository
# (You can also replace the URL below with a specific version from https://deb.opera.com/opera-gx-stable/)
RUN wget -O /tmp/opera-gx.deb https://get.opera.com/pub/opera_gx/132.0.5905.82/linux/opera-gx-stable_132.0.5905.82_amd64.deb

# Install the package and automatically fix any unmet dependencies
RUN apt-get update && apt-get install -y /tmp/opera-gx.deb \
    && rm -rf /var/lib/apt/lists/* \
    && rm /tmp/opera-gx.deb

# Switch back to the standard Kasm default user
USER kasm-user
